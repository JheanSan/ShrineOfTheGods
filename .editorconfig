root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,asmdef,json,unity,prefab,asset,mat,shader,hlsl,cginc}]
indent_size = 4

[*.{md,txt,xml}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
